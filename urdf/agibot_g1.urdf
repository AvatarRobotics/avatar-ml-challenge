<?xml version="1.0" ?>
<robot name="agibot_g1">
  <!-- Torso and Head -->
  <!-- Needed because "The kdl_parser package used in robot_state_publisher
    doesn’t like inertial properties being specified in the root link" from
    https://docs.nav2.org/setup_guides/urdf/setup_urdf.html#adding-physical-properties
    -->
  <link name="base_link"/>
  <joint name="dummy_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="dummy_base_link"/>
  </joint>
  <link name="dummy_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0134486971267798 0.00152103941353612 -0.0320076754329413"/>
